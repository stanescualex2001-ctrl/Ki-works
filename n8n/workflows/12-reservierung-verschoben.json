{
  "name": "12 Reservierung verschoben → Benachrichtigung",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reservierung-verschoben",
        "options": {}
      },
      "id": "wf12-webhook",
      "name": "Webhook: Reservierung verschoben",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "reservierung-verschoben"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.KIWORKS_FROM_EMAIL || 'noreply@ki-works.eu' }}",
        "toEmail": "={{ $json.body.restaurant?.contact_email || $env.KIWORKS_FALLBACK_EMAIL }}",
        "subject": "=🔄 Reservierung verschoben: {{ $json.body.reservation.customer_name }}, {{ $json.body.reservation.party_size }} Personen",
        "text": "=Eine Reservierung wurde auf einen neuen Termin verschoben:\n\nName: {{ $json.body.reservation.customer_name }}\nTelefon: {{ $json.body.reservation.customer_phone }}\nPersonen: {{ $json.body.reservation.party_size }}\nNeue Zeit: {{ $json.body.reservation.reserved_at }}\nNotizen: {{ $json.body.reservation.notes }}",
        "options": {}
      },
      "id": "wf12-email",
      "name": "Benachrichtigung senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [220, 0],
      "credentials": {
        "smtp": { "id": "kiworks-smtp", "name": "KiWorks SMTP" }
      }
    }
  ],
  "connections": {
    "Webhook: Reservierung verschoben": {
      "main": [[{ "node": "Benachrichtigung senden", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
