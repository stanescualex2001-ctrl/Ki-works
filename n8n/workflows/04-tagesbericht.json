{
  "id": "KiWorksTag04v002",
  "name": "04 Tagesbericht pro Kunde (21:00)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 21 * * *" }] }
      },
      "id": "wf4-schedule",
      "name": "Täglich 21:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:3001/api/stats/daily/by-restaurant",
        "options": {}
      },
      "id": "wf4-http",
      "name": "Tagesstatistik pro Kunde",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fromEmail": "info@ki-works.eu",
        "toEmail": "={{ $json.contact_email || 'info@ki-works.eu' }}",
        "subject": "=📊 Tagesbericht {{ $now.setLocale('de').toFormat('cccc, dd.MM.yyyy') }} – {{ $json.name }}: {{ $json.reservations }} Reservierungen, {{ $json.calls }} Anrufe",
        "emailFormat": "text",
        "text": "=Tagesbericht für {{ $json.name }}\n{{ $now.setLocale('de').toFormat('cccc, dd. MMMM yyyy') }}\n\nAnrufe heute: {{ $json.calls }}\nReservierungen heute: {{ $json.reservations }}\nDavon telefonisch (KI): {{ $json.phone_reservations }}\nGäste gesamt: {{ $json.guests }}\n\n—\nKiwo, Ihr digitaler Mitarbeiter · ki-works.eu\nRund um die Uhr im Einsatz, damit Sie sich aufs Wesentliche konzentrieren können.",
        "options": {}
      },
      "id": "wf4-email",
      "name": "Bericht senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [440, 0],
      "credentials": {
        "smtp": { "id": "kiworks-smtp", "name": "KiWorks SMTP" }
      }
    }
  ],
  "connections": {
    "Täglich 21:00": { "main": [[{ "node": "Tagesstatistik pro Kunde", "type": "main", "index": 0 }]] },
    "Tagesstatistik pro Kunde": { "main": [[{ "node": "Bericht senden", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Europe/Vienna" }
}
