{
  "name": "04 Tagesbericht (21:00)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 21 * * *" }] }
      },
      "id": "wf4-schedule",
      "name": "Täglich 21:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:3001/api/stats/daily",
        "options": {}
      },
      "id": "wf4-http",
      "name": "Tagesstatistik holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.KIWORKS_FROM_EMAIL || 'noreply@ki-works.eu' }}",
        "toEmail": "={{ $env.KIWORKS_FALLBACK_EMAIL }}",
        "subject": "=📊 ki-works Tagesbericht: {{ $json.reservations }} Reservierungen, {{ $json.calls }} Anrufe",
        "text": "=Tagesbericht ki-works\n\nAnrufe heute: {{ $json.calls }}\nReservierungen heute: {{ $json.reservations }}\nDavon telefonisch (KI): {{ $json.phone_reservations }}\nGäste gesamt: {{ $json.guests }}",
        "options": {}
      },
      "id": "wf4-email",
      "name": "Bericht senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [440, 0],
      "credentials": {
        "smtp": { "id": "kiworks-smtp", "name": "KiWorks SMTP" }
      }
    }
  ],
  "connections": {
    "Täglich 21:00": { "main": [[{ "node": "Tagesstatistik holen", "type": "main", "index": 0 }]] },
    "Tagesstatistik holen": { "main": [[{ "node": "Bericht senden", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Europe/Vienna" }
}
