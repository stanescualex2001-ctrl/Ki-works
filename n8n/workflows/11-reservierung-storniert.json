{
  "name": "11 Reservierung storniert → Benachrichtigung",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reservierung-storniert",
        "options": {}
      },
      "id": "wf11-webhook",
      "name": "Webhook: Reservierung storniert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "reservierung-storniert"
    },
    {
      "parameters": {
        "fromEmail": "info@ki-works.eu",
        "toEmail": "={{ $json.body.restaurant?.contact_email || 'info@ki-works.eu' }}",
        "subject": "=❌ Reservierung storniert: {{ $json.body.reservation.customer_name }}, {{ $json.body.reservation.party_size }} Personen",
        "text": "=Eine Reservierung wurde storniert:\n\nName: {{ $json.body.reservation.customer_name }}\nTelefon: {{ $json.body.reservation.customer_phone }}\nPersonen: {{ $json.body.reservation.party_size }}\nZeit: {{ $json.body.reservation.reserved_at }}\nNotizen: {{ $json.body.reservation.notes }}",
        "options": {}
      },
      "id": "wf11-email",
      "name": "Benachrichtigung senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [220, 0],
      "credentials": {
        "smtp": { "id": "kiworks-smtp", "name": "KiWorks SMTP" }
      }
    }
  ],
  "connections": {
    "Webhook: Reservierung storniert": {
      "main": [[{ "node": "Benachrichtigung senden", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
