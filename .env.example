# ki-works Konfiguration — wird vom Installer nach /etc/ki-works/ki-works.env geschrieben.
# NIEMALS echte Keys in dieses Repo committen!

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Vapi
VAPI_API_KEY=...
VAPI_PHONE_NUMBER=+1...
VAPI_WEBHOOK_SECRET=...   # frei wählbares Shared Secret, auch im Vapi-Assistant hinterlegen

# Datenbank
DATABASE_URL=postgres://kiworks:PASSWORT@127.0.0.1:5432/kiworks

# Server
PORT=3001
KIWORKS_PUBLIC_URL=https://ki-works.eu
N8N_BASE_URL=http://127.0.0.1:5678

# E-Mail (für n8n-Workflows, SMTP-Zugang im n8n-UI als "KiWorks SMTP" anlegen)
KIWORKS_FROM_EMAIL=noreply@ki-works.eu
KIWORKS_FALLBACK_EMAIL=stanescualex2001@gmail.com
