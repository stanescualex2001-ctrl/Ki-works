[Unit]
Description=ki-works Venezia-Demo-Daten-Refresh
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=kiworks
WorkingDirectory=/opt/ki-works/backend
EnvironmentFile=/etc/ki-works/ki-works.env
ExecStart=/usr/bin/node /opt/ki-works/backend/scripts/refresh-venezia-demo-data.js
