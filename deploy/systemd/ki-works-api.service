[Unit]
Description=ki-works API (Node.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=kiworks
WorkingDirectory=/opt/ki-works/backend
EnvironmentFile=/etc/ki-works/ki-works.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
